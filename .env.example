# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production

# Port the Express API listens on (Nginx will proxy to this)
PORT=4000

# Full public URL of your app (used in OAuth callback and email links)
APP_URL=https://hr.martechlabs.io

# Frontend URL (usually same as APP_URL unless you serve them separately)
FRONTEND_URL=https://hr.martechlabs.io

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:5432/dbname
# Not used by `docker-compose up` — it builds DATABASE_URL itself from the
# POSTGRES_* variables below, pointed at the bundled postgres service.
DATABASE_URL=postgresql://martechr_user:CHANGE_ME@localhost:5432/martechr

# Set to "true" if your Postgres server requires SSL (e.g. RDS, Supabase)
DATABASE_SSL=false

# ─── Docker Compose only ──────────────────────────────────────────────────────
# Credentials for the bundled `postgres` service in docker-compose.yml.
# Ignored if you're not using docker-compose (e.g. pm2 on a VM, or an
# external managed database via DATABASE_URL above).
POSTGRES_USER=mmghr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mmghr

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long issued JWTs are valid (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://hr.martechlabs.io/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ─── First SuperAdmin bootstrap ───────────────────────────────────────────────
# Login only works for emails that already exist as a user row — but only a
# SuperAdmin can add users via the Admin Panel. On first deploy (empty
# database), set these so the app creates that first SuperAdmin automatically
# on startup. Safe to leave set permanently: it's a no-op once any SuperAdmin
# exists, whether created this way or by hand later.
BOOTSTRAP_SUPERADMIN_EMAIL=you@martechlabs.io
BOOTSTRAP_SUPERADMIN_NAME=Your Name

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Your company SMTP server details
SMTP_HOST=smtp.martechlabs.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@martechlabs.io
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# Sender name + address used in From: header
SMTP_FROM=noreply@martechlabs.io

# HR admin email — receives system alerts (accrual runs, errors)
HR_EMAIL=hr@martechlabs.io

# ─── Development only ─────────────────────────────────────────────────────────
# VITE_API_URL is picked up by the Vite frontend in dev mode.
# In production, the API is served from the same origin (/api/*) so this is not needed.
# VITE_API_URL=http://localhost:4000/api

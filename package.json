{
  "name": "mmg-hr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "dev:all": "concurrently -n server,client -c blue,green \"npm:server:dev\" \"npm:dev\"",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:build": "tsc -p server/tsconfig.json && echo '{\"type\":\"commonjs\"}' > dist-server/package.json",
    "server:start": "node dist-server/index.js",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/db/migrate.ts",
    "db:bootstrap-admin": "tsx --tsconfig server/tsconfig.json server/db/bootstrapAdmin.ts",
    "db:seed": "tsx --tsconfig server/tsconfig.json scripts/seedDb.ts",
    "db:generate": "drizzle-kit generate",
    "start:prod": "pm2 start ecosystem.config.cjs --env production"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "pm2": "^7.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
